<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The provisional Documents + DocumentExtraction + DataIngestion bridge stack is consumed from
    the local feed built by scripts/build-local-feed.sh (version 10.10.0-dev). Provider adapters
    implement the real Microsoft.Extensions.DocumentExtraction.IDocumentExtractionClient and the
    bridge package maps its finalized Documents tree into IngestionDocument.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- The provisional Documents, extraction, and MEDI bridge APIs are experimental. -->
    <NoWarn>$(NoWarn);EXTEXP0019;MEAI001;MEDE0001;MEAI002;MEAI003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Real Documents + extraction + bridge + MEDI pipeline packages (local-pack). -->
    <PackageReference Include="Microsoft.Extensions.Documents.Abstractions" Version="10.10.0-dev" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0-dev" />
    <PackageReference Include="Microsoft.Extensions.DocumentExtraction" Version="10.10.0-dev" />
    <PackageReference Include="Microsoft.Extensions.DataIngestion.DocumentExtraction" Version="10.10.0-dev" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0-dev" />
    <PackageReference Include="Microsoft.Extensions.DataIngestion" Version="10.10.0-dev" />
    <!-- Credentials for every sample come from user-secrets (id iocrclient-demo), env fallback. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.9" />
    <!-- Provider SDKs (nuget.org). -->
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="Azure.AI.DocumentIntelligence" Version="1.0.0" />
    <PackageReference Include="Azure.AI.ContentUnderstanding" Version="1.1.0" />
    <!-- Native PDF text + heuristic layout for the shared PdfPigReader building block. -->
    <PackageReference Include="PdfPig" Version="0.1.15" />
  </ItemGroup>

</Project>
