<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The exact Preview 2 explicit-bridge head consumed from the hash-verified six-package local feed.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Document extraction types are marked [Experimental]; opt in explicitly. -->
    <NoWarn>$(NoWarn);MEAI001;MEDE0001;MEAI002;MEAI003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.0-preview2bridge.c191390" />
    <PackageReference Include="Microsoft.Extensions.DocumentExtraction.Abstractions" Version="10.8.0-preview2bridge.c191390" />
    <PackageReference Include="Microsoft.Extensions.DataIngestion" Version="10.8.0-preview2bridge.c191390" />
    <PackageReference Include="Microsoft.Extensions.DataIngestion.DocumentExtraction" Version="10.8.0-preview2bridge.c191390" />
    <!-- Published provider adapter; the six-package architecture feed remains exact and closed. -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.7.0" />
    <!-- Credentials for every sample come from user-secrets (id iocrclient-demo), env fallback. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.9" />
    <!-- Provider SDKs (nuget.org). -->
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="Azure.AI.DocumentIntelligence" Version="1.0.0" />
    <PackageReference Include="Azure.AI.ContentUnderstanding" Version="1.1.0" />
    <!-- Native PDF text + heuristic layout for the shared PdfPigReader building block. -->
    <PackageReference Include="PdfPig" Version="0.1.15" />
  </ItemGroup>

</Project>
