<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The provisional Documents + DocumentExtraction + DataIngestion stack is consumed as one exact,
    immutable E2E candidate. Provider adapters implement the real
    Microsoft.Extensions.DocumentExtraction.IDocumentExtractionClient.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- The provisional Documents, extraction, and MEDI bridge APIs are experimental. -->
    <NoWarn>$(NoWarn);EXTEXP0019;MEAI001;MEDE0001;MEAI002;MEAI003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exact immutable integrated E2E candidate. Core, AI, and MEDI move as one unit. -->
    <PackageReference Include="Microsoft.Extensions.Documents.Abstractions" Version="10.10.0-dev.e2e.cf60fa88.1" />
    <PackageReference Include="Microsoft.Extensions.DocumentExtraction" Version="10.10.0-dev.e2e.cf60fa88.1" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0-dev.e2e.cf60fa88.1" />
    <PackageReference Include="Microsoft.Extensions.DataIngestion" Version="10.10.0-dev.e2e.cf60fa88.1" />
    <!-- Credentials for every sample come from user-secrets (id iocrclient-demo), env fallback. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
    <!-- Provider SDKs (nuget.org). -->
    <PackageReference Include="Azure.AI.DocumentIntelligence" Version="1.0.0" />
    <PackageReference Include="Azure.AI.ContentUnderstanding" Version="1.1.0" />
    <!-- Native PDF text, faithful PDFium rendering, and optional CPU RT-DETR layout inference. -->
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.1" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="OcrShape.Tests\**\*.cs" />
  </ItemGroup>

</Project>
