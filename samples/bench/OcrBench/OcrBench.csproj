<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OcrBench — a small shared harness for the OCR-vs-PdfPig eval (sample 10). It reuses the demo's real
    IDocumentExtractionClient providers (../../ocr-shape) and the local-pack Microsoft.Extensions.AI.Evaluation stack
    plus a custom deterministic evaluator (OcrExtractionEvaluator) alongside the
    built-in NLP F1 evaluator. No ground-truth accuracy is claimed — scores are reference-free
    (structural coverage) or reference-based only against the small authored answer set in questions.json.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);MEAI001;MEDE0001;MEAI002;MEAI003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../ocr-shape/OcrShape.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation.NLP" Version="10.9.0-preview.1.26411.16" />
    <!-- Naive baseline: native PdfPig text extraction (nuget.org). -->
    <PackageReference Include="PdfPig" Version="0.1.15" />
  <!-- Real local vector store for the constant retriever held identical across rows (nuget.org). -->
  <PackageReference Include="CommunityToolkit.VectorData.InMemory" Version="1.0.0-preview.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="questions.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
