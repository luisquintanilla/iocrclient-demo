<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!--
      Provisional local pack: the exact Documents, DocumentExtraction, and DataIngestion bridge
      ancestry requested for this proof, packed at 10.10.0-dev. See scripts/build-local-feed.sh.
      Everything else (Azure SDKs, OpenAI, PdfPig) resolves from nuget.org.
    -->
    <add key="local-feed" value="./local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
