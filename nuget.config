<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!--
      Exact six-package Preview 2 neutral architecture feed from implementation commit
      6f7f3fa75d08599eb5005a0cd3db17d20694e1a8. Version
      10.8.0-preview2neutral.6f7f3fa. Everything else resolves from nuget.org.
    -->
    <add key="local-feed" value="./local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
