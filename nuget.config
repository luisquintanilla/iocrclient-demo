<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!--
      Exact six-package Preview 2 neutral architecture feed from implementation commit
      704a3e44ef4d7b053748780549fc2c8e929a444b. Version
      10.8.0-preview2neutral.704a3e4. Everything else resolves from nuget.org.
    -->
    <add key="local-feed" value="./local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
