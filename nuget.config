<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!--
      The integrated E2E stack is imported with verified hashes into validation-feed.
      The older local-feed is historical and must not satisfy new exact candidate references.
      Public dependencies resolve from the public dotnet mirror. nuget.org is
      retained but disabled here because this environment cannot complete its TLS handshake.
    -->
    <add key="validation-feed" value="./validation-feed" />
    <add key="local-feed" value="./local-feed" />
    <add key="dotnet-public" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-public/nuget/v3/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <disabledPackageSources>
    <clear />
    <add key="nuget.org" value="true" />
  </disabledPackageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="validation-feed">
      <package pattern="Microsoft.Extensions.Documents.*" />
      <package pattern="Microsoft.Extensions.DocumentExtraction*" />
      <package pattern="Microsoft.Extensions.DataIngestion*" />
      <package pattern="Microsoft.Extensions.AI" />
      <package pattern="Microsoft.Extensions.AI.*" />
    </packageSource>
    <packageSource key="dotnet-public">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
