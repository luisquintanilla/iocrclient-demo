<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!--
      Virtual monorepo local-pack: Microsoft.Extensions.AI(.Abstractions/.OpenAI),
      Microsoft.Extensions.DataIngestion(.Abstractions), and the new
      Microsoft.Extensions.DocumentExtraction(.Abstractions) built from dotnet/extensions
      data-ingestion-preview2 (@ da091f9e) with #7588 (the DocumentExtraction extraction library)
      grafted on. Version 10.8.0-dev. See scripts/build-local-feed.sh. Everything else (Azure SDKs,
      OpenAI) resolves from nuget.org. Delete this source and bump to the published versions once
      #7588 ships.
    -->
    <add key="local-feed" value="./local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
