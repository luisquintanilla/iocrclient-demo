<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!--
      Exact Preview 2 bridge feed from luisquintanilla/extensions at
      c1913907f05148370a84824b669d73249bb502e4. Version
      10.8.0-preview2bridge.c191390. See scripts/build-local-feed.sh.
    -->
    <add key="local-feed" value="./local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <packageSourceMapping>
    <packageSource key="local-feed">
      <package pattern="Microsoft.Extensions.AI" />
      <package pattern="Microsoft.Extensions.AI.Abstractions" />
      <package pattern="Microsoft.Extensions.DataIngestion" />
      <package pattern="Microsoft.Extensions.DataIngestion.Abstractions" />
      <package pattern="Microsoft.Extensions.DataIngestion.DocumentExtraction" />
      <package pattern="Microsoft.Extensions.DocumentExtraction.Abstractions" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
</configuration>
