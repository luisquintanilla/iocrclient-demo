<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!--
      Virtual monorepo local-pack: Microsoft.Extensions.AI(.Abstractions/.OpenAI) and
      Microsoft.Extensions.DataIngestion(.Abstractions) built from dotnet/extensions
      data-ingestion-preview2 with #7516 (opt-in metadata propagation) and #7588 (IOcrClient)
      grafted on. Version 10.8.0-dev. See scripts/build-local-feed.sh. Everything else (Azure SDKs,
      OpenAI) resolves from nuget.org. Delete this source and bump to the published versions once
      #7588 + #7516 ship.
    -->
    <add key="local-feed" value="./local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
