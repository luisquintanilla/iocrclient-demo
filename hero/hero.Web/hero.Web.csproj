    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>iocrclient-demo</UserSecretsId>
    <NoWarn>$(NoWarn);MEAI001;MEAI002;MEAI003;SKEXP0001;SKEXP0010;SKEXP0020;SKEXP0050</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.5.0-beta.1" />
