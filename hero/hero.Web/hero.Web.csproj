    <PackageReference Include="Microsoft.Extensions.DataIngestion" Version="10.8.0-dev" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="1.0.1" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="1.0.1" />
    <PackageReference Include="CommunityToolkit.VectorData.SqliteVec" Version="1.0.0-preview.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\hero.ServiceDefaults\hero.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\samples\ocr-shape\OcrShape.csproj" />
  </ItemGroup>

</Project>
